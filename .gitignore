## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Relies on the default dotnet ignore patterns

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
logs/
Logs/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache templates
.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userbg
*.usertasks

# SQLite database files (like filo.db if you don't want to commit database files)
*.db
*.db-shm
*.db-wal

# OS files
.DS_Store
Thumbs.db
